# Copy this file to .env and paste your keys. .env is git-ignored; never commit real keys.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: Jev judge back-end (pip install "counterfix[jev]")
TYPESAFE_API_KEY=

# Optional: override the demo's default model, e.g. llama3.2:3b for Ollama
CF_MODEL=

# Optional: the judge for diagnose() and `lint --judge`, e.g. groq:qwen/qwen3.8-27b
# (comma-separated specs make a voting panel). Empty: picked from the keys above.
COUNTERFIX_JUDGE=
